#!/usr/bin/env sh

# Pre-commit hook: runs formatting, linting, and tests on staged files
# If this hook passes, CI should be green.

echo "🔍 Running pre-commit checks..."

# Format and lint staged files using lint-staged
echo "  → Formatting and linting staged files..."
./node_modules/.bin/lint-staged || {
  echo "❌ Formatting or linting failed."
  exit 1
}

# Type check (full project - fast enough to run on everything)
echo "  → Running type check..."
./node_modules/.bin/tsc --noEmit || {
  echo "❌ Type check failed."
  exit 1
}

# Unit tests (only files related to staged changes)
echo "  → Running tests for affected files..."
STAGED_FILES=$(git diff --name-only --cached)
if [ -n "$STAGED_FILES" ]; then
  ./node_modules/.bin/vitest related --run $STAGED_FILES || {
    echo "❌ Tests failed."
    exit 1
  }
else
  echo "  ℹ️  No staged files to test."
fi

echo "✅ All pre-commit checks passed."
